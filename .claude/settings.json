{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(mise install*)",
      "Bash(mise ls*)",
      "Bash(mise doctor*)",
      "Bash(mise exec *)",
      "Bash(mise trust*)",
      "Bash(adrs *)",
      "Bash(scripts/land.sh *)",
      "Bash(bash scripts/*)",
      "Bash(scripts/bootstrap-tools.sh*)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy *)",
      "Bash(cargo test*)",
      "Bash(cargo nextest *)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo run *)",
      "Bash(cargo doc*)",
      "Bash(cargo fetch*)",
      "Bash(cargo tree*)",
      "Bash(cargo metadata*)",
      "Bash(cargo deny *)",
      "Bash(cargo llvm-cov*)",
      "Bash(cargo mutants*)",
      "Bash(cargo update -w*)",
      "Bash(cargo update --workspace*)",
      "Bash(cargo add *)",
      "Bash(rustfmt *)",
      "Bash(rustup show*)",
      "Bash(rustup target add *)",
      "Bash(rustup toolchain install*)",
      "Bash(target/debug/jfl *)",
      "Bash(target/release/jfl *)",
      "Bash(npm ci --prefix formal*)",
      "Bash(quint *)",
      "Bash(npx quint *)",
      "Bash(npx --prefix formal quint *)",
      "Bash(java -version*)",
      "Bash(javac -version*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git cat-file *)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-parse*)",
      "Bash(git branch*)",
      "Bash(git tag --list*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(git merge --ff-only *)",
      "Bash(git cherry-pick *)",
      "Bash(git worktree *)",
      "Bash(git -C *)",
      "Bash(setpriv *)",
      "Bash(mkdir -p .work/*)",
      "Bash(rm -rf /tmp/claude-*/*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push:*)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(git -c * push)",
      "Bash(git -c * push *)",
      "Bash(git --no-pager push)",
      "Bash(git --no-pager push *)",
      "Bash(git --git-dir=* push)",
      "Bash(git --git-dir=* push *)",
      "Bash(git --work-tree=* push)",
      "Bash(git --work-tree=* push *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * :*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * --tags*)",
      "Bash(git -C * push --tags*)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * push --delete*)",
      "Bash(git -C * push * --delete*)",
      "Bash(git -C * push * :*)",
      "Bash(git -C * commit --no-verify*)",
      "Bash(git -C * commit * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /boot*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /home*)",
      "Bash(rm -rf /lib*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -rf /root*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /var*)",
      "Bash(docker *)",
      "Bash(pkill *)",
      "Bash(killall *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
